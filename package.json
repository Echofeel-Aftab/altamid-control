{
  "name": "altamid-control",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "api": "npm --prefix apps/api run dev",
    "dashboard": "npm --prefix apps/dashboard start",
    "test": "npm --prefix apps/api test",
    "postinstall": "npm --prefix apps/api install --include=dev && npm --prefix apps/dashboard install --include=dev",
    "build": "npm --prefix apps/dashboard run build -- --configuration=production",
    "start": "node server.js"
  }
}
